@{
    ViewData["Title"] = L["Privacy"];
}

<section class="page-hero">
    <div class="container">
        <h1>@L["Privacy"]</h1>
        <p>@L["The current privacy policy is available on the public privacy page."]</p>
    </div>
</section>

<section class="container content-page">
    <div class="contact-panel">
        <p>@L["Please use the privacy policy page for the latest information about how booking and contact details are handled."]</p>
        <a class="btn btn-gold" href="/privacy">@L["View privacy policy"]</a>
    </div>
</section>
