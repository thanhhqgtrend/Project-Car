@{
    var siteBrandName = AppSettings.GetAsync("Site:BrandName", "Vietnam Transfer").GetAwaiter().GetResult();
    var themeInk = NormalizeThemeColor(AppSettings.GetAsync("Theme:Ink", "#151515").GetAwaiter().GetResult(), "#151515");
    var themeMuted = NormalizeThemeColor(AppSettings.GetAsync("Theme:Muted", "#6f6f6f").GetAwaiter().GetResult(), "#6f6f6f");
    var themeAccent = NormalizeThemeColor(AppSettings.GetAsync("Theme:Accent", "#c89b3c").GetAwaiter().GetResult(), "#c89b3c");
    var themeAccentDark = NormalizeThemeColor(AppSettings.GetAsync("Theme:AccentDark", "#a87920").GetAwaiter().GetResult(), "#a87920");
    var themePaper = NormalizeThemeColor(AppSettings.GetAsync("Theme:Paper", "#ffffff").GetAwaiter().GetResult(), "#ffffff");
    var themeSoft = NormalizeThemeColor(AppSettings.GetAsync("Theme:Soft", "#f7f5f0").GetAwaiter().GetResult(), "#f7f5f0");
    var themeLine = NormalizeThemeColor(AppSettings.GetAsync("Theme:Line", "#e9e4d9").GetAwaiter().GetResult(), "#e9e4d9");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteBrandName Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    @Styles.Render("~/Content/site")
    <style>
        :root {
            --ink: @themeInk;
            --muted: @themeMuted;
            --gold: @themeAccent;
            --gold-dark: @themeAccentDark;
            --paper: @themePaper;
            --soft: @themeSoft;
            --line: @themeLine;
        }
    </style>
</head>
<body class="admin-body">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <a class="admin-brand" href="/admin">
                <span>@siteBrandName</span>
                <small>Admin Console</small>
            </a>
            <nav class="admin-menu">
                <a href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a href="/admin/bookings"><i class="bi bi-calendar-check"></i> Bookings</a>
                <a href="/admin/airports"><i class="bi bi-airplane"></i> Airports</a>
                <a href="/admin/vehicles"><i class="bi bi-car-front"></i> Vehicles</a>
                <a href="/admin/addons"><i class="bi bi-plus-square"></i> Addons</a>
                <a href="/admin/popular-routes"><i class="bi bi-signpost-2"></i> Popular Routes</a>
                <a href="/admin/media"><i class="bi bi-images"></i> Media</a>
                <a href="/admin/blog"><i class="bi bi-newspaper"></i> SEO Blog</a>
                <a href="/admin/pages"><i class="bi bi-file-earmark-text"></i> CMS Pages</a>
                <a href="/admin/redirects"><i class="bi bi-signpost-split"></i> Redirects</a>
                <a href="/admin/settings"><i class="bi bi-gear"></i> Settings</a>
                <a href="/"><i class="bi bi-box-arrow-up-right"></i> Public Site</a>
            </nav>
        </aside>
        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <button class="admin-menu-toggle" type="button" data-admin-menu-toggle aria-label="Toggle admin menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="admin-current">@ViewData["Title"]</span>
                </div>
                <form method="post" action="/admin/logout">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-secondary" type="submit">Logout</button>
                </form>
            </header>
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @Scripts.Render("~/bundles/site")
    @RenderSection("Scripts", required: false)
</body>
</html>

@functions {
    private static string NormalizeThemeColor(string? value, string defaultValue)
    {
        var color = value?.Trim();
        if (color?.Length == 7 &&
            color[0] == '#' &&
            color.Skip(1).All(Uri.IsHexDigit))
        {
            return color.ToLowerInvariant();
        }

        return defaultValue;
    }
}
