</form>
<span id="brevo-success" style="display:none; color:white;">&#10003; @L["Thank you! You have subscribed successfully."]</span>

<script>
document.getElementById('brevo-newsletter-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('brevo-email').value;
    var form = new FormData();
    form.append('EMAIL', email);
    form.append('email_address_check', '');
    form.append('locale', 'en');
    fetch('https://a0642ab1.sibforms.com/serve/MUIFAFstXiKs6tm1RXOjHfxgkm0zf9onu_8PNn5fsEYrzbJB4XWNDJDxs2AKKeNvRwxnzJQDyszhR2qi963duPfL_eKuE30Skm_aSHj4z9sBaYgbC8IwLhC3mqprwq1lid7QuWC_kL1vnr1uO-0MEzMwNyPV-WreBUikCqCkMWZAG_XX2biNYXtYuoedX6h6AEcNBc-RUwk1RzS6oQ==', {
        method: 'POST',
        body: form,
        mode: 'no-cors'
    }).then(function() {
        document.getElementById('brevo-newsletter-form').style.display = 'none';
        document.getElementById('brevo-success').style.display = 'block';
    });
});
</script>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="brand-mark footer-brand"><span>@siteBrandName</span><small>@siteTagline</small></div>
                    <p>@L["Premium private transfer service across Vietnam, built for international travelers."]</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h3>@L["Service"]</h3>
                    <a href="/booking/search">@L["Airport pickup"]</a>
                    <a href="/booking/search">@L["Airport dropoff"]</a>
                    <a href="/booking/search">@L["Premium transfer"]</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h3>@L["Info"]</h3>
                    <a href="/about">@L["About us"]</a>
                    <a href="/terms">@L["Terms"]</a>
                    <a href="/privacy">Privacy</a>
                    <a href="/faq">FAQ</a>
                </div>
                <div class="col-lg-4">
                    <h3>@L["Contact"]</h3>
                    <p><i class="bi bi-telephone"></i> @L["Hotline"]: @siteHotline</p>
                    <p><i class="bi bi-envelope"></i> @siteContactEmail</p>
                    <p><i class="bi bi-geo-alt"></i> @siteAddress</p>
                </div>
            </div>
            <div class="footer-bottom">&copy; @DateTime.UtcNow.Year @siteBrandName. @L["All rights reserved."]</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>
    @Scripts.Render("~/bundles/site")
    @RenderSection("Scripts", required: false)
</body>
</html>

@functions {
    private static string NormalizeThemeColor(string? value, string defaultValue)
    {
        var color = value?.Trim();
        if (color?.Length == 7 &&
            color[0] == '#' &&
            color.Skip(1).All(Uri.IsHexDigit))
        {
            return color.ToLowerInvariant();
        }

        return defaultValue;
    }

    private static string GetLanguageName(string code)
    {
        switch ((code ?? string.Empty).ToLowerInvariant())
        {
            case "vi":
                return "Vietnamese";
            case "ko":
                return "Korean";
            case "zh":
                return "Chinese";
            case "ja":
                return "Japanese";
            case "fr":
                return "French";
            default:
                return "English";
        }
    }

    private static System.Security.Claims.ClaimsIdentity? GetCustomerIdentity(HttpContextBase httpContext)
    {
        var environment = httpContext?.Items["owin.Environment"] as System.Collections.Generic.IDictionary<string, object>;
        if (environment == null)
        {
            return null;
        }

        var owinContext = new Microsoft.Owin.OwinContext(environment);
        var result = owinContext.Authentication
            .AuthenticateAsync("CustomerCookie")
            .GetAwaiter()
            .GetResult();

        return result?.Identity;
    }
}
