@model List<CarBookingAddon>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Addons";
    var status = ViewData["Status"]?.ToString() ?? "active";
    var search = ViewData["Search"]?.ToString() ?? string.Empty;
}

<section class="admin-shell">
    <div class="admin-page-heading">
        <div><h1>Addons</h1><p>Manage customer-facing booking add-ons and prices.</p></div>
        <a class="btn btn-gold" href="/admin/addons/create">Create addon</a>
    </div>

    <form class="admin-filter" method="get">
        <div class="col-md-3">
            <select class="form-select" name="status">
                <option value="active" selected="@(status == "active")">Active</option>
                <option value="inactive" selected="@(status == "inactive")">Inactive</option>
                <option value="all" selected="@(status == "all")">All</option>
            </select>
        </div>
        <div class="col-md-5"><input class="form-control" name="search" value="@search" placeholder="Search name or description" /></div>
        <div class="col-md-2"><button class="btn btn-outline-gold w-100">Filter</button></div>
    </form>

    <div class="admin-panel">
        <div class="table-responsive admin-table">
            <table class="table align-middle mb-0">
                <thead><tr><th>Image</th><th>Name</th><th>Pricing</th><th>Order</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-muted">No addons found.</td></tr>
                    }
                    @foreach (var addon in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(addon.Image?.SecureUrl))
                                {
                                    <img class="admin-addon-thumb" src="@CloudinaryUrlHelper.For(addon.Image, CloudinaryUrlHelper.AddonCheckoutThumb)" alt="@addon.Name" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="admin-addon-thumb admin-addon-thumb-empty"><i class="bi bi-image"></i></span>
                                }
                            </td>
                            <td><strong>@addon.Name</strong><br><small>@addon.Description</small></td>
                            <td>
                                <strong>@addon.PricingMode</strong><br>
                                <small>
                                    @(addon.PriceUsd == 0 ? "Free" : $"${addon.PriceUsd:0.00}")
                                    @if (addon.PricingMode == AddonPricingMode.Quantity && addon.IncludedQuantity > 0)
                                    {
                                        <span> Â· @addon.IncludedQuantity free</span>
                                    }
                                </small>
                            </td>
                            <td>@addon.DisplayOrder</td>
                            <td><span class="admin-status">@(addon.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-gold" href="/admin/addons/@addon.Id/edit">Edit</a>
                                @if (addon.IsActive)
                                {
                                    <form class="d-inline" method="post" action="/admin/addons/@addon.Id/deactivate">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Deactivate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
