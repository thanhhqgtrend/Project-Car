@model BlogPostFormViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var mode = (ViewData["BlogFormMode"] as string) ?? "Edit";
    var cloudinaryConfigured = ViewData["CloudinaryConfigured"] as bool? ?? false;
    var notice = TempData["AdminNotice"] as string;
    ViewData["Title"] = mode + " Blog Post";
    var action = mode == "Create" ? "/admin/blog/create" : $"/admin/blog/{Model.Id}/edit";
    var publishedAtValue = Model.PublishedAt.HasValue ? Model.PublishedAt.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty;
}

<section class="admin-shell">
    <a href="/admin/blog?culture=@Model.Culture" class="admin-back">&larr; Back to SEO blog</a>
    <div class="admin-page-heading">
        <div>
            <h1>@mode blog post</h1>
            <p>Write multilingual content, SEO metadata, Open Graph fields and publishing schedule.</p>
        </div>
        @if (mode != "Create" && !string.IsNullOrWhiteSpace(Model.Slug))
        {
            <a class="btn btn-outline-gold" href="/admin/blog/@Model.Id/preview?culture=@Model.Culture" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Preview</a>
        }
    </div>

    @if (!cloudinaryConfigured)
    {
        <div class="alert alert-warning">Cloudinary is not configured. Existing media can be selected, but new image upload requires Cloudinary credentials.</div>
    }
    @if (!string.IsNullOrWhiteSpace(notice))
    {
        <div class="alert alert-info">@notice</div>
    }

    <form class="admin-panel blog-editor-form" method="post" action="@action" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <ul class="nav nav-pills settings-tab-nav" id="blogEditorTabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#blog-content" type="button" role="tab"><i class="bi bi-pencil-square"></i> Content</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#blog-seo" type="button" role="tab"><i class="bi bi-search"></i> SEO</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#blog-media" type="button" role="tab"><i class="bi bi-image"></i> Media</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#blog-publish" type="button" role="tab"><i class="bi bi-calendar-check"></i> Publish</button></li>
        </ul>

        <div class="tab-content settings-tab-content">
            <div class="tab-pane fade show active" id="blog-content" role="tabpanel" tabindex="0">
            @Html.Partial("BlogForm/_ContentTab", Model)
            @Html.Partial("BlogForm/_SeoTab", Model)
            @Html.Partial("BlogForm/_MediaTab", Model)
            @Html.Partial("BlogForm/_PublishTab", Model)
            </div>
        </div>

        <div class="admin-form-actions">
            <a class="btn btn-outline-secondary" href="/admin/blog?culture=@Model.Culture">Cancel</a>
            <button class="btn btn-gold" type="submit"><i class="bi bi-check2"></i> Save blog post</button>
        </div>
    </form>
</section>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
