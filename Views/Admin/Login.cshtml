@model LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<section class="admin-login">
    <form method="post" action="/admin/login" class="admin-login-card" novalidate>
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ReturnUrl)
        <div class="admin-login-heading">
            <h1>Admin login</h1>
            <p>Sign in to manage bookings, content, media and site settings.</p>
        </div>
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        <div class="mb-3">
            @Html.LabelFor(model => model.Email, new { @class = "form-label" })
            @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", autocomplete = "username", placeholder = "admin@example.com", required = "required", autofocus = "autofocus" })
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.Password, new { @class = "form-label" })
            <div class="input-group">
                @Html.PasswordFor(model => model.Password, new { @class = "form-control", autocomplete = "current-password", placeholder = "Password", required = "required" })
                <button class="btn btn-outline-secondary js-toggle-password" type="button" aria-controls="Password" aria-label="Show password">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small" })
        </div>
        <div class="admin-login-options">
            <div class="form-check">
                @Html.CheckBoxFor(model => model.RememberMe, new { @class = "form-check-input" })
                @Html.LabelFor(model => model.RememberMe, "Remember me", new { @class = "form-check-label" })
            </div>
            <a href="/">Back to website</a>
        </div>
        <button class="btn btn-gold w-100 mt-3" type="submit">Sign in</button>
    </form>
</section>

