<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Autofac.Mvc5</id>
    <version>6.1.0</version>
    <authors>Autofac Contributors</authors>
    <owners>Autofac Contributors</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://autofac.org/</projectUrl>
    <description>ASP.NET MVC 5 integration for Autofac.</description>
    <releaseNotes>Release notes are at https://github.com/autofac/Autofac.Mvc/releases</releaseNotes>
    <copyright>Copyright © 2015 Autofac Contributors</copyright>
    <tags>autofac di ioc dependencyinjection</tags>
    <repository type="git" url="https://github.com/autofac/Autofac.Mvc" commit="b20c81b7c2dbadfc0833a8f93e9ac83ac65adfd0" />
    <dependencies>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="Autofac" version="6.4.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNet.Mvc" version="5.1.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNet.Razor" version="3.1.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNet.WebPages" version="3.1.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Web.Infrastructure" version="1.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Web" targetFramework=".NETFramework4.7.2" />
    </frameworkAssemblies>
    <icon>icon.png</icon>
    <readme>README.md</readme>
  </metadata>
</package>